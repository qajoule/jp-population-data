---
import "../styles/base.css";
import { contentSecurityPolicy } from "../csp-policy.mjs";

type Props = { title: string };
const { title } = Astro.props;
const description = "日本政府・各省庁が公開する年齢別人口と自殺の統計を、出所と計算手順を明示して可視化した静的サイト。";
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL("/ogp.png", Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" type="image/x-icon" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-512.png" sizes="512x512" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" type="image/png" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline src="/theme-toggle.js" defer></script>
    <script is:inline src="/figure-readout.js" defer></script>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <h1>{title}</h1>
        <div class="site-tools">
          <button class="theme-control" type="button" aria-label="テーマ切替" aria-pressed="false">
            <span class="theme-track" aria-hidden="true">
              <svg class="theme-mark theme-mark--sun" aria-hidden="true" viewBox="0 0 16 16"><circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M12.6 3.4l-1.4 1.4M4.8 11.2l-1.4 1.4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.5" /></svg>
              <svg class="theme-mark theme-mark--moon" aria-hidden="true" viewBox="0 0 16 16"><path d="M13.5 10.3A6 6 0 0 1 5.7 2.5a6 6 0 1 0 7.8 7.8Z" fill="currentColor" /></svg>
              <span class="theme-knob"></span>
            </span>
          </button>
        </div>
      </div>
    </header>
    <main>
      <div class="intro">
        <p>当サイトは "自殺" や "年齢別の人口" のデータを取り扱っていますが、特定の主張やその支持をするものではありません。政府や各省庁が公式に公開している情報をまとめ、グラフとして視覚化したものです。なお、<strong>自殺死亡率は、公表されている自殺者数と人口をもとに当サイトが計算した値です。</strong></p>
        <p>また、当サイトは<a href="https://github.com/qajoule/jp-population-data" rel="noopener">オープンソース</a>です。細心の注意を払っておりますが、データの誤り等がございましたら<a href="https://forms.gle/QWaeZSii8NdYHoSs5" rel="noopener">こちらのフォーム</a>からご連絡頂けますと幸いです。</p>
      </div>
      <slot />
      <footer class="site-footer">
        <section class="helpline" aria-labelledby="helpline-title">
          <h2 id="helpline-title">相談窓口</h2>
          <p class="break-keep">こころの悩みや不安<wbr />については、<wbr />公的な相談窓口が<wbr />あります。</p>
          <ul>
            <li class="break-keep">#いのちSOS<wbr /> <a href="tel:0120-061-338">0120-061-338</a><wbr />（24時間・通話無料）</li>
            <li class="break-keep">よりそいホットライン<wbr /> <a href="tel:0120-279-338">0120-279-338</a><wbr />（24時間・通話無料）</li>
            <li class="break-keep">24時間子供SOSダイヤル<wbr /> <a href="tel:0120-0-78310">0120-0-78310</a><wbr />（24時間・通話無料）</li>
          </ul>
          <p class="helpline-date break-keep">電話番号と受付時間は<wbr /> 2026-09-13 に<wbr />厚生労働省のページで<wbr />確認したものです。</p>
          <p class="break-keep">その他の窓口と<wbr /> SNS 相談は、<wbr />厚生労働省「<a href="https://www.mhlw.go.jp/mamorouyokokoro/" rel="noopener">まもろうよ こころ</a>」<wbr />に一覧があります。</p>
        </section>
        <div class="footer-license-band">
          <div class="footer-links">
            <div class="footer-links__row">
              <span class="break-keep">文章・図・派生データ:<wbr /> <a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener">CC BY 4.0</a></span>
              <span class="break-keep">e-Stat のデータ:<wbr /> 政府標準利用規約（第 2.0 版）<wbr />準拠<wbr /> <a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener">CC BY 4.0</a><wbr /> 互換</span>
              <span class="break-keep">コード:<wbr /> <a href="https://github.com/qajoule/jp-population-data/blob/main/LICENSE" rel="noopener">MIT License</a></span>
            </div>
            <div class="footer-links__row">
              <a class="break-keep" href="https://github.com/qajoule/jp-population-data" rel="noopener">GitHub</a>
              <a class="break-keep" href="https://forms.gle/QWaeZSii8NdYHoSs5" rel="noopener">当サイトに関する<wbr />お問い合わせ</a>
            </div>
            <div class="footer-links__row">
              <span class="break-keep">© 2026 椎名一霤</span>
            </div>
          </div>
        </div>
      </footer>
    </main>
  </body>
</html>
